{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RiskRadar",
  "description": "Explainable S/A/B/C risk radar. Every item carries its full rationale.",
  "type": "object",
  "required": ["items", "updated_at"],
  "properties": {
    "course_id": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["exam_point_id", "topic_id", "topic_name", "priority", "priority_rationale"],
        "properties": {
          "exam_point_id": { "type": "string" },
          "topic_id": { "type": "string" },
          "topic_name": { "type": "string" },
          "priority": { "enum": ["S", "A", "B", "C"] },
          "priority_rationale": { "type": "array", "items": { "type": "string" } },
          "importance": { "type": "integer" },
          "likelihood_estimate": { "type": "number" },
          "past_exam_frequency": { "type": "integer" },
          "teacher_emphasis": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "updated_at": { "type": "string" }
  }
}
