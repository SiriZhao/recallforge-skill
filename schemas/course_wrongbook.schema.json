{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CourseWrongbook",
  "description": "Per-course wrongbook containing only real wrong answers.",
  "type": "object",
  "required": ["course_id", "entries", "updated_at"],
  "properties": {
    "course_id": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question_id", "question_text", "user_answer", "correct_answer", "wrong_reason", "trap_type"],
        "properties": {
          "question_id": { "type": "string" },
          "question_text": { "type": "string" },
          "user_answer": { "type": "string" },
          "correct_answer": { "type": "string" },
          "wrong_reason": { "type": "string" },
          "trap_type": { "type": "string" },
          "fix_strategy": { "type": "string" },
          "next_review_date": { "type": ["string", "null"] },
          "evidence_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "updated_at": { "type": "string" }
  }
}
