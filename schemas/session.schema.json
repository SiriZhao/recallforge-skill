{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionRecord",
  "description": "One study behavior (practice/quiz/review/tutor/cram). The only input allowed to mutate the student model.",
  "type": "object",
  "required": ["session_id", "course_id", "date", "kind", "started_at"],
  "properties": {
    "session_id": { "type": "string" },
    "course_id": { "type": "string" },
    "date": { "type": "string" },
    "kind": { "enum": ["practice", "quiz", "review", "tutor", "cram"] },
    "items": { "type": "array", "items": { "type": "object" } },
    "answers": { "type": "array", "items": { "type": "object" } },
    "diagnosis": { "type": "object" },
    "started_at": { "type": "string" },
    "ended_at": { "type": ["string", "null"] }
  }
}
